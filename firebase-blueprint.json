{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "imvu_nick": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "client"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role", "created_at"]
    },
    "Order": {
      "title": "Order",
      "description": "Order information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "order_code": { "type": "string" },
        "user_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "customer_email": { "type": "string" },
        "whatsapp": { "type": "string" },
        "imvu_nick": { "type": "string" },
        "player_id": { "type": "string" },
        "player_nick": { "type": "string" },
        "instagram_handle": { "type": "string" },
        "customer_instagram": { "type": "string" },
        "customer_whatsapp": { "type": "string" },
        "external_proof_received": { "type": "boolean" },
        "external_proof_channel": { "type": "string", "enum": ["instagram", "whatsapp", "outro"] },
        "external_proof_note": { "type": "string" },
        "access_email": { "type": "string" },
        "notes": { "type": "string" },
        "product_type": { "type": "string" },
        "product_name": { "type": "string" },
        "product_category": { "type": "string", "enum": ["credits", "service", "produto_mn", "free_fire", "seguidores"] },
        "amount_k": { "type": "number" },
        "total_price": { "type": "number" },
        "proof_image_url": { "type": "string" },
        "proof_file_name": { "type": "string" },
        "proof_verification_status": { "type": "string", "enum": ["validado", "pendente_verificacao_manual", "rejeitado"] },
        "proof_verification_reason": { "type": "string" },
        "payment_method": { "type": "string" },
        "payment_status": { "type": "string" },
        "status": { "type": "string", "enum": ["aguardando comprovante", "aguardando pagamento", "em análise", "pagamento confirmado", "em entrega", "entregue", "cancelado"] },
        "admin_note": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "order_code", "user_id", "customer_name", "customer_email", "product_type", "product_name", "product_category", "total_price", "status", "created_at", "updated_at"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Store settings",
      "type": "object",
      "properties": {
        "pix_key": { "type": "string" },
        "pix_name": { "type": "string" },
        "whatsapp": { "type": "string" },
        "instagram_official": { "type": "string" },
        "whatsapp_official": { "type": "string" },
        "proof_instructions": { "type": "string" },
        "store_notice": { "type": "string" },
        "store_open": { "type": "boolean" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["pix_key", "pix_name", "whatsapp", "store_notice", "store_open", "updated_at"]
    },
    "SupportConversation": {
      "title": "SupportConversation",
      "description": "Support conversation for direct chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "customer_email": { "type": "string" },
        "subject": { "type": "string" },
        "status": { "type": "string", "enum": ["aberta", "respondida", "aguardando cliente", "resolvida", "fechada"] },
        "last_message": { "type": "string" },
        "unread_count_admin": { "type": "number" },
        "unread_count_client": { "type": "number" },
        "typing_client": { "type": "boolean" },
        "typing_admin": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customer_name", "customer_email", "status", "created_at", "updated_at"]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Individual support message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversation_id": { "type": "string" },
        "sender_type": { "type": "string", "enum": ["client", "admin"] },
        "sender_id": { "type": "string" },
        "message": { "type": "string" },
        "image_url": { "type": "string" },
        "file_url": { "type": "string" },
        "file_name": { "type": "string" },
        "file_type": { "type": "string" },
        "receipt_verification_status": { "type": "string", "enum": ["validado", "pendente_verificacao_manual", "rejeitado"] },
        "read": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["conversation_id", "sender_type", "message", "read", "created_at"]
    }
  },
  "firestore": {
    "profiles/{profileId}": {
      "schema": "Profile",
      "description": "Collection of user profiles"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of orders"
    },
    "settings/config": {
      "schema": "Settings",
      "description": "Single settings document"
    },
    "support_conversations/{conversationId}": {
      "schema": "SupportConversation",
      "description": "Main collection for support conversations"
    },
    "support_conversations/{conversationId}/messages/{messageId}": {
      "schema": "SupportMessage",
      "description": "Subcollection for message in a conversation"
    }
  }
}
