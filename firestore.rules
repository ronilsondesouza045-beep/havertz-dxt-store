rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && 
             request.auth.token.get('email', '').lower() == 'havertz.dxt@gmail.com';
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128; }

    // --- Projections ---
    function isValidProfile(data) {
      return data.get('id', '') == request.auth.uid &&
             data.get('email', '') is string && data.get('email', '').size() <= 256 &&
             data.get('name', '') is string && data.get('name', '').size() <= 128 &&
             data.get('role', '') in ['admin', 'client'] &&
             (data.get('imvu_nick', null) == null || (data.imvu_nick is string && data.imvu_nick.size() <= 64));
    }

    function isValidOrder(data) {
      return data.get('user_id', '') is string && data.get('user_id', '').size() <= 128 &&
             data.get('order_code', '') is string && data.get('order_code', '').size() <= 64 &&
             data.get('status', '') is string &&
             data.get('total_price', 0) is number && data.get('total_price', 0) >= 0;
    }

    function isValidConversation(data) {
      return data.get('customer_email', '') is string && data.get('customer_email', '').size() <= 256 &&
             data.get('status', '') in ['aberta', 'respondida', 'fechada', 'resolvida'];
    }

    function isValidMessage(data) {
      return (data.get('conversation_id', '') is string && data.get('conversation_id', '').size() <= 128) &&
             (data.get('sender_type', '') in ['admin', 'client']) &&
             (data.get('message', '') is string && data.get('message', '').size() <= 10000);
    }

    function isValidReview(data) {
      return data.get('user_id', '') == request.auth.uid &&
             data.get('rating', 0) is number && data.get('rating', 0) >= 1 && data.get('rating', 0) <= 5 &&
             data.get('category', '') is string && data.get('category', '').size() <= 64 &&
             data.get('comment', '') is string && data.get('comment', '').size() <= 1000 &&
             data.get('user_name', '') is string && data.get('user_name', '').size() <= 128;
    }

    // --- Matches ---

    match /profiles/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidProfile(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && 
                       isValidProfile(incoming()) &&
                       (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'imvu_nick', 'whatsapp']));
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (
        isAdmin() || 
        resource.data.get('user_id', '') == request.auth.uid || 
        resource.data.get('customer_email', '') == request.auth.token.get('email', '')
      );
      allow list: if isSignedIn() && (
        isAdmin() || 
        resource.data.get('user_id', '') == request.auth.uid || 
        resource.data.get('customer_email', '') == request.auth.token.get('email', '')
      );
      allow create: if isSignedIn() && isOwner(incoming().get('user_id', '')) && isValidOrder(incoming());
      allow update: if isSignedIn() && (
        isAdmin() || 
        ((isOwner(existing().get('user_id', '')) || existing().get('customer_email', '') == request.auth.token.get('email', '')) && (
          // Action: Standard update
          (incoming().get('status', '') == existing().get('status', '') || (incoming().get('status', '') == 'aguardando comprovante' && existing().get('status', '') == 'aguardando comprovante')) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['imvu_nick', 'player_id', 'player_nick', 'instagram_handle', 'access_email', 'notes', 'payment_status', 'updated_at'])
        ) || (
          // Action: Soft delete
          (isOwner(existing().get('user_id', '')) || existing().get('customer_email', '') == request.auth.token.get('email', '')) && 
          incoming().get('is_deleted', false) == true &&
          incoming().diff(existing()).affectedKeys().hasOnly(['is_deleted', 'deleted_by', 'deleted_at', 'status', 'payment_status', 'updated_at'])
        ))
      ) && isValidOrder(incoming());
    }

    match /support_conversations/{conversationId} {
      allow get: if isValidId(conversationId) && (
        isAdmin() || 
        resource == null || 
        resource.data.get('user_id', null) == null || 
        (isSignedIn() && resource.data.get('user_id', null) == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        isAdmin() || 
        resource.data.get('user_id', null) == request.auth.uid
      );
      allow create: if (isSignedIn() && isOwner(incoming().get('user_id', null))) || (!isSignedIn() && incoming().get('user_id', null) == null);
      allow update: if isAdmin() || existing().get('user_id', null) == null || (isSignedIn() && existing().get('user_id', null) == request.auth.uid);
    }

    match /support_conversations/{conversationId}/messages/{messageId} {
      allow read: if isValidId(conversationId) && (
        isAdmin() || 
        get(/databases/$(database)/documents/support_conversations/$(conversationId)).data.get('user_id', null) == null || 
        (isSignedIn() && get(/databases/$(database)/documents/support_conversations/$(conversationId)).data.get('user_id', null) == request.auth.uid)
      );
      allow create: if isValidId(conversationId) && (
        isAdmin() || 
        get(/databases/$(database)/documents/support_conversations/$(conversationId)).data.get('user_id', null) == null || 
        (isSignedIn() && get(/databases/$(database)/documents/support_conversations/$(conversationId)).data.get('user_id', null) == request.auth.uid)
      ) && isValidMessage(incoming());
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.get('is_visible', true) == true || isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && isValidReview(incoming()) && incoming().get('is_visible', true) == true;
      allow update: if (isAdmin() || (isSignedIn() && existing().user_id == request.auth.uid)) && 
                       isValidReview(incoming()) &&
                       (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'category', 'comment', 'updated_at', 'is_visible']));
      allow delete: if isAdmin() || (isSignedIn() && existing().user_id == request.auth.uid);
    }
  }
}
