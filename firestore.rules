rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin'; 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Projections ---
    function isValidProfile(data) {
      return data.id == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.name is string && data.name.size() <= 128 &&
             data.role in ['admin', 'client'] &&
             (data.imvu_nick is string && data.imvu_nick.size() <= 64);
    }

    function isValidOrder(data) {
      return data.user_id is string && data.user_id.size() <= 128 &&
             data.order_code is string && data.order_code.size() <= 32 &&
             data.status in ['aguardando pagamento', 'em processamento', 'concluido', 'cancelado'] &&
             data.total_price is number && data.total_price >= 0;
    }

    function isValidConversation(data) {
      return data.customer_email is string && data.customer_email.size() <= 256 &&
             data.status in ['aberta', 'fechada', 'pendente'];
    }

    function isValidMessage(data) {
      return data.conversation_id is string && data.conversation_id.size() <= 128 &&
             data.sender_type in ['admin', 'client'] &&
             data.message is string && data.message.size() <= 10000;
    }

    // --- Matches ---

    match /profiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidProfile(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && 
                       isValidProfile(incoming()) &&
                       (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'imvu_nick']));
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (isOwner(existing().user_id) || isAdmin());
      allow list: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isOwner(incoming().user_id) && isValidOrder(incoming());
      allow update: if isSignedIn() && (isAdmin() || (isOwner(existing().user_id) && incoming().status == existing().status)) &&
                       isValidOrder(incoming()) &&
                       (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['imvu_nick']));
    }

    match /support_conversations/{conversationId} {
      allow get: if isSignedIn() && (isOwner(existing().user_id) || isAdmin());
      allow list: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isOwner(incoming().user_id) && isValidConversation(incoming());
      allow update: if isSignedIn() && (isOwner(existing().user_id) || isAdmin()) &&
                       isValidConversation(incoming());
    }

    match /support_conversations/{conversationId}/messages/{messageId} {
      allow read: if isSignedIn() && (isOwner(get(/databases/$(database)/documents/support_conversations/$(conversationId)).data.user_id) || isAdmin());
      allow create: if isSignedIn() && (isOwner(get(/databases/$(database)/documents/support_conversations/$(conversationId)).data.user_id) || isAdmin()) &&
                       isValidMessage(incoming());
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
